{
    "name": "unirate/statamic",
    "description": "Statamic v5 addon for the UniRate API — Antlers tags for live currency exchange rates, conversion, currencies, and VAT rates.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "unirate",
        "currency",
        "exchange-rates",
        "forex",
        "vat",
        "fintech"
    ],
    "homepage": "https://github.com/UniRate-API/statamic-unirate",
    "authors": [
        {
            "name": "Unirate Team",
            "homepage": "https://unirateapi.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "statamic/cms": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "UniRate\\Statamic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniRate\\Statamic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "UniRate",
            "description": "Live currency exchange rates, conversion, and VAT rates via the UniRate API."
        },
        "laravel": {
            "providers": [
                "UniRate\\Statamic\\ServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable"
}
